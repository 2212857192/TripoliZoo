APP_NAME="حديقة حيوان طرابلس"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# عنوان يصل إليه الزائر عند مسح QR — استخدم IP شبكة الواي فاي (مثال: http://192.168.7.3:8000)
# VISITOR_PUBLIC_URL=http://192.168.7.3:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP — فعّل التحقق بخطوتين ثم App Password من google.com/apppasswords
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

PLATFORM_NAME="Tripoli Zoo"
PLATFORM_NAME_AR="حديقة حيوان طرابلس"

# Firebase Cloud Messaging (HTTP v1) — Service Account JSON
# Firebase Console > Project Settings > Service accounts > Generate new private key
FCM_PROJECT_ID=tripolizoo
FCM_CREDENTIALS=storage/app/firebase-credentials.json

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Plutu — بوابة الدفع الإلكتروني
# API Key و Access Token من لوحة Plutu → Configurations → API Keys & Token
PLUTU_API_KEY=
PLUTU_ACCESS_TOKEN=
PLUTU_SECRET_KEY=
